# Postgres connection string
DATABASE_URL=postgres://honnibear:honnibear_dev@localhost:5432/honnibear

# Server
PORT=4000
# Comma-separated list of origins allowed to call this API (your deployed static site + localhost for dev)
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Stripe
# Secret key from your Stripe dashboard (sandbox key while testing)
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the webhook endpoint, from Stripe dashboard > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin auth
JWT_SECRET=change-this-to-a-long-random-string
# Used only by `npm run seed:admin` to create the first admin user
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# Email (optional — leave blank to skip sending and just log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Honnibear <hello@honnibear.example>"
